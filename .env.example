# ===================================
# Base de datos (PostgreSQL 16 self-hosted)
# ===================================
# Local: PG16 sin TLS.
# Producción: TLS obligatorio (sslmode=require/verify-full), IP privada del
# Servidor BD, rol de aplicación SIN superusuario. Ver PDF v3.0 §4.
DATABASE_URL=postgresql://abent3t_app:CHANGE_ME@localhost:5433/abent3t_db?schema=public

# ===================================
# Autenticación
# ===================================
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=8h
REFRESH_TOKEN_EXPIRES_IN=7d

ALLOWED_EMAIL_DOMAIN=abent3t.com

# En PROD: ALLOW_LOCAL_LOGIN=false (solo OIDC). En DEV: true (email+password).
ALLOW_LOCAL_LOGIN=false

# Microsoft Entra ID (OAuth 2.0 / OIDC)
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_REDIRECT_URI=https://plataforma.abent3t.com/auth/callback

# ===================================
# Storage (MinIO S3-compatible)
# ===================================
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET_EVIDENCES=evidences
MINIO_BUCKET_PROPOSALS=proposal-attachments

PORT=3001

# Orígenes permitidos por CORS. Una sola URL o varias separadas por coma.
# Aplica tanto al HTTP API como a los WebSockets.
#   FRONTEND_URL=https://app.abent3t.com,https://staging.abent3t.com
FRONTEND_URL=http://localhost:3000

# ===================================
# RATE LIMITING (Throttler)
# ===================================
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# ===================================
# CONFIGURACIÓN DE EMAIL (Microsoft/Azure)
# ===================================
# Dejar vacío para modo simulación (logging).
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_EMAIL_FROM=noreply@abent3t.com

# ===================================
# CONFIGURACIÓN DE RECORDATORIOS
# ===================================
REMINDERS_ENABLED=true
REMINDER_FIRST_DAYS=3
REMINDER_FOLLOWUP_DAYS=7
REMINDER_ESCALATION_DAYS=14
