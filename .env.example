# ============================================================================
# abent3t-api — Variables de entorno
# El schema de validación vive en src/config/env.validation.ts (Fase 0, T1):
# si falta una variable requerida, la app NO arranca y el error la nombra.
# Guía de despliegue: documentation/DEPLOY_ENV_CHECKLIST.md
# ============================================================================

# ===================================
# Núcleo
# ===================================
# development | test | production
NODE_ENV=development
PORT=3001

# Orígenes permitidos por CORS. Una sola URL o varias separadas por coma.
# Aplica tanto al HTTP API como a los WebSockets.
#   FRONTEND_URL=https://app.abent3t.com,https://staging.abent3t.com
FRONTEND_URL=http://localhost:3000

# ===================================
# Base de datos (PostgreSQL 16 self-hosted) — REQUERIDA
# ===================================
# Local: PG16 sin TLS.
# Producción: TLS obligatorio (sslmode=require/verify-full), IP privada del
# Servidor BD, rol de aplicación SIN superusuario. Ver PDF v3.0 §4.
DATABASE_URL=postgresql://abent3t_app:CHANGE_ME@localhost:5433/abent3t_db?schema=public

# ===================================
# Autenticación — JWT_SECRET REQUERIDA
# ===================================
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=8h
REFRESH_TOKEN_EXPIRES_IN=7d

ALLOWED_EMAIL_DOMAIN=abent3t.com

# En PROD: ALLOW_LOCAL_LOGIN=false (solo OIDC). En DEV: true (email+password).
ALLOW_LOCAL_LOGIN=false

# Microsoft Entra ID (OAuth 2.0 / OIDC) — vacías hasta que TI entregue credenciales
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_REDIRECT_URI=https://plataforma.abent3t.com/auth/callback

# ===================================
# Storage (MinIO S3-compatible) — REQUERIDAS
# ===================================
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
# El SDK exige una región pero MinIO la ignora (default: us-east-1)
# MINIO_REGION=us-east-1
MINIO_BUCKET_EVIDENCES=evidences
MINIO_BUCKET_PROPOSALS=proposal-attachments
MINIO_BUCKET_CONTRACTS=contracts
MINIO_BUCKET_COMMITTEES=purchase-committees

# ===================================
# Cifrado de credenciales de integraciones — REQUERIDA (mínimo 32 caracteres)
# ===================================
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PLATFORM_ENCRYPTION_KEY=CHANGE_ME_MINIMO_32_CARACTERES_ALEATORIOS

# ===================================
# RATE LIMITING (Throttler)
# ===================================
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# ===================================
# CONFIGURACIÓN DE EMAIL (Microsoft/Azure)
# ===================================
# Dejar vacío para modo simulación (logging).
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_EMAIL_FROM=noreply@abent3t.com

# ===================================
# CONFIGURACIÓN DE RECORDATORIOS
# ===================================
REMINDERS_ENABLED=true
REMINDER_FIRST_DAYS=3
REMINDER_FOLLOWUP_DAYS=7
REMINDER_ESCALATION_DAYS=14

# ===================================
# Compras — import administrativo (transitorio, ver Fase 4 de la auditoría)
# ===================================
# Máximo de elementos por lote en POST /requisitions/import
REQUISITIONS_IMPORT_MAX_BATCH=500

# ===================================
# IBM Maximo — integración (Fases 1-3; hoy solo configuración)
# ===================================
# Con MAXIMO_SYNC_ENABLED=false las demás MAXIMO_* pueden quedar vacías.
# Con true, las tres son REQUERIDAS (la app no arranca si faltan).
MAXIMO_SYNC_ENABLED=false
# API REST legacy (Object Structures AB_COMPRAS / AB_CONTRATOS) — SOLO GET
MAXIMO_BASE_URL=
# API OSLC alternativa (filtros de rango con oslc.where)
MAXIMO_OSLC_URL=
# Token Base64 para el header MAXAUTH. NUNCA en el repo ni en logs.
MAXIMO_AUTH_TOKEN=
# Fase INT-2: lectura de AB_CONTRATOS. Dejar false hasta que CIISA confirme
# CONTRACTREFNUM / CONTRACTVALUE (§20.2). AB_COMPRAS no depende de este flag.
MAXIMO_CONTRACTS_ENABLED=false
# Fase INT-3: sync a staging (solo aplican con MAXIMO_SYNC_ENABLED=true).
# Intervalo del cron en minutos y tamaño de página del full scan legacy.
MAXIMO_SYNC_INTERVAL_MINUTES=60
MAXIMO_SYNC_PAGE_SIZE=100

# ===================================
# SAP Business One — Service Layer (Fase 5; hoy solo configuración)
# ===================================
# Endpoint del Service Layer. En TEST el cert TLS es propio: usar
# SL_REJECT_UNAUTHORIZED=false SOLO en entornos no productivos
# (con NODE_ENV=production el arranque falla si es false).
SL_BASE_URL=https://abent-3t.seidormexico.cloud:50000/b1s/v2
SL_COMPANY_DB=TEST_ABENT_170326
SL_USER=
SL_PASSWORD=
SL_REJECT_UNAUTHORIZED=true
