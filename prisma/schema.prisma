  delivery_confirmed_at    DateTime?                  @db.Timestamptz(6)
  confirmed_by             String?                    @db.Uuid
  notes                    String?
  is_active                Boolean                    @default(true)
  purchase_orders          purchase_orders            @relation(fields: [purchase_order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  profiles                 profiles?                  @relation(fields: [confirmed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  delivery_tracking_events delivery_tracking_events[]
  expediting_alerts        expediting_alerts[]

  @@index([expected_date], map: "idx_delivery_tracking_expected")
  @@index([current_status], map: "idx_delivery_tracking_status")
}

