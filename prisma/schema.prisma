generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model accounting_okrs {
  id                    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  titulo                String            @db.VarChar(255)
  descripcion           String?
  periodo               String            @db.VarChar(20)
  tipo                  okr_type
  parent_okr_id         String?           @db.Uuid
  target_value          Decimal?          @db.Decimal(18, 2)
  current_value         Decimal?          @default(0) @db.Decimal(18, 2)
  unit                  String?           @db.VarChar(50)
  status                okr_status?       @default(on_track)
  due_date              DateTime?         @db.Date
  created_by            String?           @db.Uuid
  is_active             Boolean?          @default(true)
  created_at            DateTime?         @default(now()) @db.Timestamptz(6)
  updated_at            DateTime?         @default(now()) @updatedAt @db.Timestamptz(6)
  profiles              profiles?         @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  accounting_okrs       accounting_okrs?  @relation("accounting_okrsToaccounting_okrs", fields: [parent_okr_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_accounting_okrs accounting_okrs[] @relation("accounting_okrsToaccounting_okrs")

  @@index([parent_okr_id], map: "idx_accounting_okrs_parent")
  @@index([periodo], map: "idx_accounting_okrs_periodo")
  @@index([status], map: "idx_accounting_okrs_status")
  @@index([tipo], map: "idx_accounting_okrs_tipo")
}

model approval_workflows {
  id             String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requisition_id String                    @unique @db.Uuid
  current_level  Int?                      @default(1)
  status         approval_workflow_status? @default(pendiente)
  started_at     DateTime?                 @default(now()) @db.Timestamptz(6)
  completed_at   DateTime?                 @db.Timestamptz(6)
  is_active      Boolean?                  @default(true)
  created_at     DateTime?                 @default(now()) @db.Timestamptz(6)
  updated_at     DateTime?                 @default(now()) @updatedAt @db.Timestamptz(6)
  requisitions   requisitions              @relation(fields: [requisition_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  approvals      approvals[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model approvals {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflow_id        String             @db.Uuid
  level              Int
  approver_id        String             @db.Uuid
  status             approval_status?   @default(pendiente)
  comments           String?
  approved_at        DateTime?          @db.Timestamptz(6)
  rejected_at        DateTime?          @db.Timestamptz(6)
  rejection_reason   String?
  time_to_approve    Int?
  notified_at        DateTime?          @db.Timestamptz(6)
  is_active          Boolean?           @default(true)
  created_at         DateTime?          @default(now()) @db.Timestamptz(6)
  updated_at         DateTime?          @default(now()) @updatedAt @db.Timestamptz(6)
  profiles           profiles           @relation(fields: [approver_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approval_workflows approval_workflows @relation(fields: [workflow_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([workflow_id, level], map: "approvals_workflow_level_key")
  @@index([workflow_id], map: "idx_approvals_workflow")
}

model audit_logs {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  action      audit_action
  entity_type audit_entity
  entity_id   String       @db.Uuid
  entity_name String?      @db.VarChar(255)
  user_id     String       @db.Uuid
  user_name   String?      @db.VarChar(255)
  user_role   String?      @db.VarChar(50)
  old_values  Json?
  new_values  Json?
  description String?
  ip_address  String?      @db.VarChar(45)
  user_agent  String?
  created_at  DateTime?    @default(now()) @db.Timestamp(6)
  profiles    profiles     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([action], map: "idx_audit_logs_action")
  @@index([created_at(sort: Desc)], map: "idx_audit_logs_created_at")
  @@index([entity_type, entity_id], map: "idx_audit_logs_entity")
  @@index([user_id], map: "idx_audit_logs_user_id")
}

model budgets {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  department_id   String      @db.Uuid
  period_id       String      @db.Uuid
  assigned_amount Decimal     @default(0) @db.Decimal
  consumed_amount Decimal     @default(0) @db.Decimal
  is_active       Boolean     @default(true)
  created_at      DateTime    @default(now()) @db.Timestamptz(6)
  updated_at      DateTime    @default(now()) @updatedAt @db.Timestamptz(6)
  departments     departments @relation(fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  periods         periods     @relation(fields: [period_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([department_id], map: "idx_budgets_department_id")
  @@index([period_id], map: "idx_budgets_period_id")
}

model cfdis {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  uuid                   String    @unique @db.VarChar(36)
  tipo                   cfdi_type
  rfc_emisor             String    @db.VarChar(13)
  nombre_emisor          String?   @db.VarChar(250)
  rfc_receptor           String    @db.VarChar(13)
  nombre_receptor        String?   @db.VarChar(250)
  fecha_emision          DateTime  @db.Timestamptz(6)
  fecha_certificacion    DateTime? @db.Timestamptz(6)
  subtotal               Decimal?  @default(0) @db.Decimal(18, 2)
  descuento              Decimal?  @default(0) @db.Decimal(18, 2)
  total                  Decimal   @db.Decimal(18, 2)
  moneda                 String?   @default("MXN") @db.VarChar(3)
  tipo_cambio            Decimal?  @default(1) @db.Decimal(18, 6)
  forma_pago             String?   @db.VarChar(50)
  metodo_pago            String?   @db.VarChar(10)
  uso_cfdi               String?   @db.VarChar(10)
  version_complementaria Boolean?  @default(false)
  uuid_relacionado       String?   @db.VarChar(36)
  xml_content            String?
  status                 String?   @default("vigente") @db.VarChar(50)
  downloaded_at          DateTime? @default(now()) @db.Timestamptz(6)
  is_active              Boolean?  @default(true)
  created_at             DateTime? @default(now()) @db.Timestamptz(6)

  @@index([fecha_emision], map: "idx_cfdis_fecha_emision")
  @@index([rfc_emisor], map: "idx_cfdis_rfc_emisor")
  @@index([rfc_receptor], map: "idx_cfdis_rfc_receptor")
  @@index([tipo], map: "idx_cfdis_tipo")
  @@index([uuid], map: "idx_cfdis_uuid")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model course_editions {
  id                              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  course_id                       String               @db.Uuid
  start_date                      DateTime             @db.Date
  end_date                        DateTime?            @db.Date
  location                        String?              @db.VarChar(255)
  instructor                      String?              @db.VarChar(255)
  max_participants                Int?
  is_active                       Boolean              @default(true)
  created_at                      DateTime             @default(now()) @db.Timestamptz(6)
  updated_at                      DateTime             @default(now()) @updatedAt @db.Timestamptz(6)
  prorate_cost                    Boolean?             @default(false)
  require_evidence_for_completion Boolean?             @default(true)
  cost_override                   Decimal?             @db.Decimal
  payment_status                  String?              @default("pending")
  payment_reference               String?              @db.VarChar(255)
  payment_date                    DateTime?            @db.Date
  courses                         courses              @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  course_enrollments              course_enrollments[]
  course_proposals                course_proposals[]
  training_requests               training_requests[]

  @@index([course_id], map: "idx_course_editions_course")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model course_enrollments {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  course_edition_id    String                 @db.Uuid
  profile_id           String                 @db.Uuid
  status               String                 @default("inscrito")
  enrolled_at          DateTime               @default(now()) @db.Timestamptz(6)
  completed_at         DateTime?              @db.Timestamptz(6)
  notes                String?
  is_active            Boolean                @default(true)
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  updated_at           DateTime               @default(now()) @updatedAt @db.Timestamptz(6)
  course_editions      course_editions        @relation(fields: [course_edition_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "course_enrollments_edition_fkey")
  profiles             profiles               @relation(fields: [profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "course_enrollments_profile_fkey")
  course_proposals     course_proposals[]
  enrollment_evidences enrollment_evidences[]
  training_requests    training_requests[]

  @@unique([course_edition_id, profile_id], map: "course_enrollments_unique")
  @@index([course_edition_id], map: "idx_enrollments_edition")
  @@index([profile_id], map: "idx_enrollments_profile")
  @@index([status], map: "idx_enrollments_status")
}

model course_proposals {
  id                                              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  proposed_by                                     String                 @db.Uuid
  profile_id                                      String                 @db.Uuid
  course_name                                     String                 @db.VarChar(255)
  institution_name                                String?                @db.VarChar(255)
  course_url                                      String?
  estimated_cost                                  Decimal?               @default(0) @db.Decimal
  estimated_hours                                 Int?                   @default(0)
  modality                                        String?                @db.VarChar(50)
  start_date                                      DateTime?              @db.Date
  end_date                                        DateTime?              @db.Date
  justification                                   String?
  status                                          proposal_status?       @default(pendiente)
  reviewed_by                                     String?                @db.Uuid
  reviewed_at                                     DateTime?              @db.Timestamp(6)
  review_notes                                    String?
  rejection_reason                                String?
  course_id                                       String?                @db.Uuid
  course_edition_id                               String?                @db.Uuid
  enrollment_id                                   String?                @db.Uuid
  is_active                                       Boolean?               @default(true)
  created_at                                      DateTime?              @default(now()) @db.Timestamp(6)
  updated_at                                      DateTime?              @default(now()) @updatedAt @db.Timestamp(6)
  course_editions                                 course_editions?       @relation(fields: [course_edition_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  courses                                         courses?               @relation(fields: [course_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  course_enrollments                              course_enrollments?    @relation(fields: [enrollment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  profiles_course_proposals_profile_idToprofiles  profiles               @relation("course_proposals_profile_idToprofiles", fields: [profile_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  profiles_course_proposals_proposed_byToprofiles profiles               @relation("course_proposals_proposed_byToprofiles", fields: [proposed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  profiles_course_proposals_reviewed_byToprofiles profiles?              @relation("course_proposals_reviewed_byToprofiles", fields: [reviewed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  proposal_attachments                            proposal_attachments[]
}

model course_types {
