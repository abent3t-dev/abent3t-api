// =============================================================================
// Fase INT-3 — Staging Maximo (0005_maximo_staging.sql)
//
// Las claves naturales son índices únicos sobre expresiones coalesce
// (uq_maximo_po_natural_key / uq_maximo_contract_natural_key) que Prisma no
// puede modelar: el upsert del sync engine va por findFirst + create/update
// con manejo de carrera P2002. Sin relaciones Prisma a propósito (scalars):
// staging no participa del grafo de dominio hasta Int-5.
// =============================================================================

model maximo_sync_runs {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  target               maximo_sync_target
  triggered_by         maximo_sync_trigger
  triggered_by_user_id String?             @db.Uuid
  started_at           DateTime            @default(now()) @db.Timestamptz(6)
  finished_at          DateTime?           @db.Timestamptz(6)
  status               maximo_sync_status  @default(running)
  pages_total          Int?
  pages_ok             Int                 @default(0)
  records_fetched      Int                 @default(0)
  records_inserted     Int                 @default(0)
  records_updated      Int                 @default(0)
  records_unchanged    Int                 @default(0)
  records_failed       Int                 @default(0)
  filter_warnings      Json?
  error_summary        String?
  mapper_version       String

  @@index([target, started_at(sort: Desc)], map: "idx_maximo_sync_runs_target_started")
  @@index([status], map: "idx_maximo_sync_runs_status")
}

