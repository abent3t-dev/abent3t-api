model delivery_tracking {
  id                       String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purchase_order_id        String                     @unique @db.Uuid
  expected_date            DateTime                   @db.Date
  current_status           delivery_status            @default(pendiente)
  last_alert_sent          DateTime?                  @db.Timestamptz(6)
