// ============================================================================
// Comité de Compras (§16, prisma/sql/0007_purchase_committees.sql) —
// aprobación secuencial DATA-DRIVEN: el motor lee committee_approval_levels
// (§20.A.5 abierta: confirmed=false hasta que Ingrid confirme el mapeo).
// ============================================================================

model purchase_committees {
  id                     String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  committee_number       String               @unique
  committee_date         DateTime             @db.Date
  title                  String
  description            String?
  status                 committee_status     @default(borrador)
  current_version        Int                  @default(1)
  current_approver_level Int?
  submitted_at           DateTime?            @db.Timestamptz(6)
  approved_at            DateTime?            @db.Timestamptz(6)
  total_elapsed_hours    Decimal?             @db.Decimal(10, 2)
  created_by             String               @db.Uuid
  created_at             DateTime?            @default(now()) @db.Timestamptz(6)
  updated_at             DateTime?            @default(now()) @updatedAt @db.Timestamptz(6)
  is_active              Boolean              @default(true)
  profiles               profiles             @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  committee_versions     committee_versions[]
  committee_approvals    committee_approvals[]

  @@index([status], map: "idx_committees_status")
  @@index([committee_date], map: "idx_committees_date")
  @@index([created_by], map: "idx_committees_author")
}

model committee_versions {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  committee_id        String              @db.Uuid
