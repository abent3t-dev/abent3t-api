// ============================================================================

model contracts {
  id                     String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contract_number        String                          @unique
  tomo                   String?
  document_type          contract_document_type
  service_description    String
  supplier_id            String                          @db.Uuid
  start_date             DateTime                        @db.Date
  end_date               DateTime                        @db.Date
  total_amount           Decimal?                        @db.Decimal(14, 2)
  currency               String?                         @default("MXN")
  buyer_profile_id       String?                         @db.Uuid
  responsible_user_email String?
  responsible_user_name  String?
  status                 contract_status                 @default(vigente)
  notes                  String?
  is_active              Boolean                         @default(true)
  created_by             String?                         @db.Uuid
  created_at             DateTime?                       @default(now()) @db.Timestamptz(6)
  updated_at             DateTime?                       @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at             DateTime?                       @db.Timestamptz(6)
  deleted_by             String?                         @db.Uuid
  suppliers              suppliers                       @relation(fields: [supplier_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  profiles_contracts_buyer_profile_idToprofiles profiles? @relation("contracts_buyer_profile_idToprofiles", fields: [buyer_profile_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  profiles_contracts_created_byToprofiles       profiles? @relation("contracts_created_byToprofiles", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  profiles_contracts_deleted_byToprofiles       profiles? @relation("contracts_deleted_byToprofiles", fields: [deleted_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contract_documents            contract_documents[]
  contract_expiry_notifications contract_expiry_notifications[]
  purchase_orders               purchase_orders[]

  @@index([status], map: "idx_contracts_status")
  @@index([supplier_id], map: "idx_contracts_supplier")
  @@index([end_date], map: "idx_contracts_end_date")
}

